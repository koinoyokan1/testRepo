{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "description": "Renovate configuration for Black Duck vulnerability remediation",
  "enabledManagers": ["gomod", "npm", "docker-compose", "dockerfile", "regex"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "separateMinorPatch": true,
  "separateMultipleMajor": true,
  "rangeStrategy": "update-lockfile",
  "semanticCommits": "enabled",
  "commitMessagePrefix": "fix(deps):",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{#if isMajor}}v{{{newMajor}}}{{else}}{{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}",
  "labels": [
    "dependencies",
    "security"
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "regexManagers": [
    {
      "fileMatch": ["^image_map\\.json$"],
      "matchStrings": [
        "\"origin_image\":\\s*\"(?<depName>[^:]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Extract OS-level package versions from Dockerfiles (apk add)",
      "fileMatch": ["(^|/)Dockerfile$", "(^|/)Dockerfile\\.[^/]*$"],
      "matchStrings": [
        "RUN\\s+apk\\s+(?:add|--no-cache\\s+add)\\s+.*?(?<depName>[a-z0-9-]+)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "alpine/{{{depName}}}"
    },
    {
      "description": "Extract OS-level package versions from Dockerfiles (apt-get install)",
      "fileMatch": ["(^|/)Dockerfile$", "(^|/)Dockerfile\\.[^/]*$"],
      "matchStrings": [
        "RUN\\s+apt-get\\s+install\\s+.*?(?<depName>[a-z0-9-]+)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "debian/{{{depName}}}"
    },
    {
      "description": "Extract OS-level package versions from Dockerfiles (yum install)",
      "fileMatch": ["(^|/)Dockerfile$", "(^|/)Dockerfile\\.[^/]*$"],
      "matchStrings": [
        "RUN\\s+yum\\s+install\\s+.*?(?<depName>[a-z0-9-]+)-(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "rhel/{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Disable all updates by default - only Black Duck findings will be enabled",
      "matchPackagePatterns": ["*"],
      "matchManagers": ["gomod", "npm"],
      "enabled": false
    },
    {
      "description": "Enable all Docker image updates dynamically from image_map.json",
      "matchManagers": ["regex"],
      "matchFileNames": ["image_map.json"],
      "enabled": true,
      "groupName": "container-images",
      "prTitle": "Container base image upgrade: {{depName}} to {{newVersion}}",
      "labels": [
        "dependencies",
        "security",
        "container-image"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "security"
    }
  ]
}
