        "",
        "This PR was created based on Black Duck security scan findings."
      ],
      "labels": [
        "security",
        "high-priority",
        "blackduck",
        "cve-2021-23337",
        "cve-2020-8203",
        "npm"
      ],
      "reviewers": [
        "adam@company.com",
        "blake@company.com",
        "clara@company.com",
        "zoe@company.com"
      ],
      "addLabels": [
        "component:analytics-plugin",
        "component:admin-dashboard"
      ]
    },
