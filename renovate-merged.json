{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "description": "Renovate configuration for Black Duck vulnerability remediation",
  "enabledManagers": [
    "gomod",
    "npm",
    "docker-compose",
    "dockerfile",
    "regex"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "separateMinorPatch": true,
  "separateMultipleMajor": true,
  "rangeStrategy": "update-lockfile",
  "semanticCommits": "enabled",
  "commitMessagePrefix": "fix(deps):",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{#if isMajor}}v{{{newMajor}}}{{else}}{{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}",
  "labels": [
    "dependencies",
    "security"
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "regexManagers": [
    {
      "fileMatch": [
        "^image_map\\.json$"
      ],
      "matchStrings": [
        "\"origin_image\":\\s*\"(?<depName>[^:]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Extract OS-level package versions from Dockerfiles (apk add)",
      "fileMatch": [
        "(^|/)Dockerfile$",
        "(^|/)Dockerfile\\.[^/]*$"
      ],
      "matchStrings": [
        "RUN\\s+apk\\s+(?:add|--no-cache\\s+add)\\s+.*?(?<depName>[a-z0-9-]+)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "alpine/{{{depName}}}"
    },
    {
      "description": "Extract OS-level package versions from Dockerfiles (apt-get install)",
      "fileMatch": [
        "(^|/)Dockerfile$",
        "(^|/)Dockerfile\\.[^/]*$"
      ],
      "matchStrings": [
        "RUN\\s+apt-get\\s+install\\s+.*?(?<depName>[a-z0-9-]+)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "debian/{{{depName}}}"
    },
    {
      "description": "Extract OS-level package versions from Dockerfiles (yum install)",
      "fileMatch": [
        "(^|/)Dockerfile$",
        "(^|/)Dockerfile\\.[^/]*$"
      ],
      "matchStrings": [
        "RUN\\s+yum\\s+install\\s+.*?(?<depName>[a-z0-9-]+)-(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "rhel/{{{depName}}}"
    },
    {
      "description": "Black Duck - CVE-2026-55555 (HIGH) - alpine package in Dockerfile",
      "fileMatch": [
        "^services\\/web-frontend\\/Dockerfile$"
      ],
      "matchStrings": [
        "RUN\\s+apk\\s+[^\\n]*?(?:add|install)[^\\n]*?curl=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "curl",
      "datasourceTemplate": "repology-repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "alpine:curl",
      "extractVersionTemplate": "^(?<version>.+)$",
      "enabled": true
    },
    {
      "description": "Black Duck - CVE-2026-66666 (CRITICAL) - alpine package in Dockerfile",
      "fileMatch": [
        "^services\\/auth\\/Dockerfile$"
      ],
      "matchStrings": [
        "RUN\\s+apk\\s+[^\\n]*?(?:add|install)[^\\n]*?git=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "git",
      "datasourceTemplate": "repology-repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "alpine:git",
      "extractVersionTemplate": "^(?<version>.+)$",
      "enabled": true
    },
    {
      "description": "Black Duck - CVE-2026-77777 (CRITICAL) - alpine package in Dockerfile",
      "fileMatch": [
        "^services\\/api-gateway\\/Dockerfile$"
      ],
      "matchStrings": [
        "RUN\\s+apk\\s+[^\\n]*?(?:add|install)[^\\n]*?openssl=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "openssl",
      "datasourceTemplate": "repology-repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "alpine:openssl",
      "extractVersionTemplate": "^(?<version>.+)$",
      "enabled": true
    },
    {
      "description": "Black Duck - CVE-2026-88888 (HIGH) - alpine package in Dockerfile",
      "fileMatch": [
        "^services\\/auth\\/Dockerfile$"
      ],
      "matchStrings": [
        "RUN\\s+apk\\s+[^\\n]*?(?:add|install)[^\\n]*?musl=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "musl",
      "datasourceTemplate": "repology-repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "alpine:musl",
      "extractVersionTemplate": "^(?<version>.+)$",
      "enabled": true
    }
  ],
  "packageRules": [
    {
      "description": "Disable all updates by default - only Black Duck findings will be enabled",
      "matchPackagePatterns": [
        "*"
      ],
      "matchManagers": [
        "gomod",
        "npm"
      ],
      "enabled": false
    },
    {
      "description": "Black Duck - CVE-2026-11111 (HIGH) - go",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/sirupsen/logrus"
      ],
      "allowedVersions": "1.9.3",
      "enabled": true,
      "groupName": null,
      "separateMinorPatch": false,
      "branchName": "blackduck/go/logrus/cve-2026-11111",
      "commitMessageTopic": "github.com/sirupsen/logrus",
      "prTitle": "Go package upgrade: update logrus to v1.9.3 to fix CVE-2026-11111 (HIGH)",
      "prBodyNotes": [
        "### \ud83d\udd12 Security Update - Black Duck Finding (GO)",
        "",
        "**Vulnerability**: CVE-2026-11111",
        "**Severity**: HIGH (CVSS 8.2)",
        "**Ecosystem**: go",
        "**Current Version**: 1.8.1",
        "**Fixed Version**: 1.9.3 (minimum safe version)",
        "**Version Constraint**: 1.9.3",
        "",
        "**Description**: Log injection vulnerability in logrus allowing arbitrary code execution",
        "",
        "**Remediation**: Update github.com/sirupsen/logrus to exactly version 1.9.3 as recommended by Black Duck.",
        "",
        "This PR was created based on Black Duck security scan findings."
      ],
      "labels": [
        "security",
        "high-priority",
        "blackduck",
        "cve-2026-11111",
        "go"
      ]
    },
